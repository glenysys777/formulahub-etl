{
  "id": "demo-lookup-join-mapper-local-postgres",
  "name": "LOCAL: Orders + customers lookup → Field Mapper → Postgres",
  "description": "LOCAL_PROVEN retarget of lookup-join-mapper: same local CSV sources → join → map → formulahub_wedge.customers_wedge. LIVE_EXTERNAL = UNPROVEN.",
  "version": "1.0",
  "nodes": [
    {
      "id": "orders",
      "type": "local_file_source",
      "label": "Orders CSV",
      "config": {
        "path": "fixtures/sample/orders_17cols.csv",
        "format": "csv"
      },
      "position": { "x": 40, "y": 120 }
    },
    {
      "id": "customers",
      "type": "local_file_source",
      "label": "Customers CSV (lookup)",
      "config": {
        "path": "fixtures/sample/customers.csv",
        "format": "csv"
      },
      "position": { "x": 40, "y": 280 }
    },
    {
      "id": "join",
      "type": "lookup_join",
      "label": "Lookup Join",
      "config": {
        "left_keys": ["customer_id"],
        "right_keys": ["customer_id"],
        "how": "left",
        "match": "first"
      },
      "position": { "x": 320, "y": 180 }
    },
    {
      "id": "field_mapper",
      "type": "tmap",
      "label": "Field Mapper → customers_wedge",
      "config": {
        "mappings": [
          "customer_id=str(customer_id)",
          "email=lower(email)",
          "signup_date=order_date",
          "loaded_at='local-lookup'"
        ],
        "drop_unmapped": true
      },
      "position": { "x": 560, "y": 180 }
    },
    {
      "id": "dedupe",
      "type": "dedupe",
      "label": "Dedupe customer_id",
      "config": { "keys": ["customer_id"], "keep": "first" },
      "position": { "x": 780, "y": 180 }
    },
    {
      "id": "dest",
      "type": "postgres_destination",
      "label": "Postgres LOCAL (customers_wedge)",
      "config": {
        "host": "localhost",
        "port": 5432,
        "database": "formulahub_wedge",
        "table": "customers_wedge",
        "if_exists": "replace",
        "demo_output_dir": "data/out/local_postgres/lookup_join"
      },
      "position": { "x": 1000, "y": 120 }
    },
    {
      "id": "csv",
      "type": "local_file_destination",
      "label": "Local CSV mirror",
      "config": {
        "path": "data/out/lookup_join_customers_wedge.csv",
        "format": "csv"
      },
      "position": { "x": 1000, "y": 280 }
    }
  ],
  "edges": [
    {
      "id": "e-orders-join",
      "source": "orders",
      "target": "join",
      "sourceHandle": "out",
      "targetHandle": "in"
    },
    {
      "id": "e-customers-join",
      "source": "customers",
      "target": "join",
      "sourceHandle": "out",
      "targetHandle": "right"
    },
    { "id": "e-join-map", "source": "join", "target": "field_mapper", "sourceHandle": "out" },
    { "id": "e-map-dedupe", "source": "field_mapper", "target": "dedupe" },
    { "id": "e-dedupe-dest", "source": "dedupe", "target": "dest" },
    { "id": "e-dedupe-csv", "source": "dedupe", "target": "csv" }
  ],
  "metadata": {
    "demo": false,
    "classification": "LOCAL_PROVEN",
    "requires_demo_mode": false,
    "honesty": "LOCAL CSVs + LOCAL Postgres. Not LIVE_EXTERNAL.",
    "adapted_from": "demos/lookup-join-mapper/pipeline.json"
  }
}
