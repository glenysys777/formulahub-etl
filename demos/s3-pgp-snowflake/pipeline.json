{
  "id": "demo-s3-pgp-snowflake",
  "name": "S3 → PGP → Validate → Snowflake",
  "description": "Spectacular demo: read encrypted CSV from mock S3, decrypt with PGP, parse, validate 17 columns, transform dates, load to Snowflake (demo), archive source, write rejects.",
  "version": "1.0",
  "nodes": [
    {
      "id": "s3",
      "type": "s3_source",
      "label": "S3 Source",
      "config": {
        "bucket": "demo",
        "key": "demo/orders_encrypted.csv.pgp"
      },
      "position": { "x": 40, "y": 180 }
    },
    {
      "id": "pgp",
      "type": "pgp_decrypt",
      "label": "PGP Decrypt",
      "config": {
        "private_key_path": "fixtures/keys/demo_private.asc",
        "passphrase": ""
      },
      "position": { "x": 260, "y": 180 }
    },
    {
      "id": "parse",
      "type": "csv_parser",
      "label": "CSV Parse",
      "config": {
        "delimiter": ","
      },
      "position": { "x": 480, "y": 180 }
    },
    {
      "id": "validate",
      "type": "schema_validate",
      "label": "Schema Validate",
      "config": {
        "columns": {
          "order_id": "int",
          "customer_id": "int",
          "customer_name": "string",
          "email": "email",
          "phone": "string",
          "country": "string",
          "city": "string",
          "product_sku": "string",
          "product_name": "string",
          "quantity": "int",
          "unit_price": "float",
          "currency": "string",
          "order_date": "string",
          "ship_date": "date",
          "status": "string",
          "channel": "string",
          "notes": "string"
        },
        "required_columns": [
          "order_id",
          "customer_id",
          "customer_name",
          "email",
          "product_sku",
          "quantity",
          "unit_price",
          "order_date",
          "ship_date",
          "status"
        ]
      },
      "position": { "x": 700, "y": 180 }
    },
    {
      "id": "transform",
      "type": "transform",
      "label": "Transform Dates",
      "config": {
        "cast": {
          "order_date": {
            "type": "date",
            "input_format": "%m/%d/%Y",
            "output_format": "%Y-%m-%d"
          },
          "ship_date": {
            "type": "date",
            "input_format": "%Y-%m-%d",
            "output_format": "%Y-%m-%d"
          },
          "quantity": "int",
          "unit_price": "float",
          "order_id": "int",
          "customer_id": "int"
        },
        "add_constants": {
          "loaded_by": "formulaetl"
        }
      },
      "position": { "x": 920, "y": 80 }
    },
    {
      "id": "metrics",
      "type": "logger_metrics",
      "label": "Metrics",
      "config": {
        "label": "post-transform",
        "log_sample": 1
      },
      "position": { "x": 1140, "y": 80 }
    },
    {
      "id": "snowflake",
      "type": "snowflake_destination",
      "label": "Snowflake (demo)",
      "config": {
        "database": "DEMO_DB",
        "schema": "PUBLIC",
        "table": "ORDERS",
        "demo_output_dir": "data/out/snowflake"
      },
      "position": { "x": 1360, "y": 80 }
    },
    {
      "id": "rejects",
      "type": "local_file_destination",
      "label": "Rejects File",
      "config": {
        "path": "data/rejects/orders_rejects.csv",
        "format": "csv"
      },
      "position": { "x": 920, "y": 300 }
    },
    {
      "id": "archive",
      "type": "archive_files",
      "label": "Archive Source",
      "config": {
        "destination": "data/archive/",
        "mode": "move"
      },
      "position": { "x": 1360, "y": 300 }
    }
  ],
  "edges": [
    { "id": "e1", "source": "s3", "target": "pgp" },
    { "id": "e2", "source": "pgp", "target": "parse" },
    { "id": "e3", "source": "parse", "target": "validate" },
    { "id": "e4", "source": "validate", "target": "transform", "sourceHandle": "out" },
    { "id": "e5", "source": "transform", "target": "metrics" },
    { "id": "e6", "source": "metrics", "target": "snowflake" },
    { "id": "e7", "source": "validate", "target": "rejects", "sourceHandle": "rejects" },
    { "id": "e8", "source": "snowflake", "target": "archive" }
  ],
  "metadata": {
    "demo": true,
    "requires_demo_mode": true,
    "workspace_folder": "Pipelines/Demos"
  }
}
