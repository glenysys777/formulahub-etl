{
  "id": "demo-excel-to-file",
  "name": "Excel → Map → Transform → CSV + Excel",
  "description": "Client use case: read spreadsheet orders from Excel, rename columns, cast dates/amounts, validate schema, write CSV and Excel locally (no cloud creds).",
  "version": "1.0",
  "nodes": [
    {
      "id": "excel",
      "type": "excel_source",
      "label": "Excel Source",
      "config": {
        "path": "fixtures/sample/orders.xlsx",
        "sheet_name": "Orders",
        "has_header": true
      },
      "position": { "x": 40, "y": 180 }
    },
    {
      "id": "map",
      "type": "column_map",
      "label": "Column Map",
      "config": {
        "mappings": [
          "Order ID:order_id",
          "Customer ID:customer_id",
          "Customer Name:customer_name",
          "Email:email",
          "Product SKU:product_sku",
          "Qty:quantity",
          "Amount:amount",
          "Order Date:order_date",
          "Status:status",
          "Currency:currency",
          "Channel:channel"
        ],
        "drop_unmapped": false
      },
      "position": { "x": 260, "y": 180 }
    },
    {
      "id": "transform",
      "type": "transform",
      "label": "Transform Dates",
      "config": {
        "cast": {
          "order_date": {
            "type": "date",
            "input_format": "%m/%d/%Y",
            "output_format": "%Y-%m-%d"
          },
          "quantity": "int",
          "amount": "float",
          "order_id": "int",
          "customer_id": "int"
        },
        "add_constants": {
          "loaded_by": "formulaetl"
        }
      },
      "position": { "x": 480, "y": 180 }
    },
    {
      "id": "validate",
      "type": "schema_validate",
      "label": "Schema Validate",
      "config": {
        "columns": {
          "order_id": "int",
          "customer_id": "int",
          "customer_name": "string",
          "email": "email",
          "product_sku": "string",
          "quantity": "int",
          "amount": "float",
          "order_date": "date",
          "status": "string",
          "currency": "string",
          "channel": "string"
        },
        "required_columns": [
          "order_id",
          "customer_id",
          "customer_name",
          "email",
          "product_sku",
          "quantity",
          "amount",
          "order_date",
          "status"
        ]
      },
      "position": { "x": 700, "y": 180 }
    },
    {
      "id": "dest_csv",
      "type": "local_file_destination",
      "label": "Local CSV",
      "config": {
        "path": "data/out/excel_orders.csv",
        "format": "csv"
      },
      "position": { "x": 920, "y": 80 }
    },
    {
      "id": "dest_xlsx",
      "type": "excel_destination",
      "label": "Excel Out",
      "config": {
        "path": "data/out/excel_orders.xlsx",
        "sheet_name": "Orders",
        "has_header": true
      },
      "position": { "x": 920, "y": 280 }
    }
  ],
  "edges": [
    { "id": "e1", "source": "excel", "target": "map" },
    { "id": "e2", "source": "map", "target": "transform" },
    { "id": "e3", "source": "transform", "target": "validate" },
    { "id": "e4", "source": "validate", "target": "dest_csv", "sourceHandle": "out" },
    { "id": "e5", "source": "validate", "target": "dest_xlsx", "sourceHandle": "out" }
  ],
  "metadata": {
    "demo": true,
    "requires_demo_mode": true,
    "use_case": "excel-to-file"
  }
}
