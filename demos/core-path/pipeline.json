{
  "id": "demo-core-path",
  "name": "Excel → Field Mapper → Aggregate → CSV",
  "description": "Spreadsheet in → Field Mapper (rename + expressions) → filter → sort → aggregate → CSV. FormulaHub ETL core path.",
  "version": "1.0",
  "nodes": [
    {
      "id": "excel",
      "type": "excel_source",
      "label": "Excel Source",
      "config": {
        "path": "fixtures/sample/orders.xlsx",
        "sheet_name": "Orders",
        "has_header": true
      },
      "position": {
        "x": 40,
        "y": 180
      }
    },
    {
      "id": "field_mapper",
      "type": "tmap",
      "label": "Field Mapper",
      "config": {
        "mappings": [
          "order_id=int(col(\"Order ID\"))",
          "customer_id=int(col(\"Customer ID\"))",
          "customer_name=col(\"Customer Name\")",
          "email=col(\"Email\")",
          "product_sku=col(\"Product SKU\")",
          "quantity=int(col(\"Qty\"))",
          "amount=float(col(\"Amount\"))*1.1",
          "order_date=col(\"Order Date\")",
          "status=lower(col(\"Status\"))",
          "currency=col(\"Currency\")",
          "channel=upper(col(\"Channel\"))"
        ],
        "drop_unmapped": true
      },
      "position": {
        "x": 260,
        "y": 180
      }
    },
    {
      "id": "filter",
      "type": "filter",
      "label": "Filter Shipped",
      "config": {
        "expression": "status == 'shipped'"
      },
      "position": {
        "x": 480,
        "y": 180
      }
    },
    {
      "id": "sort",
      "type": "sort",
      "label": "Sort Amount",
      "config": {
        "keys": [
          "amount:desc"
        ]
      },
      "position": {
        "x": 700,
        "y": 180
      }
    },
    {
      "id": "agg",
      "type": "aggregate",
      "label": "Aggregate",
      "config": {
        "group_by": [
          "status"
        ],
        "aggs": [
          "sum:amount",
          "count:*",
          "avg:amount"
        ]
      },
      "position": {
        "x": 920,
        "y": 180
      }
    },
    {
      "id": "dest",
      "type": "local_file_destination",
      "label": "Local CSV",
      "config": {
        "path": "data/out/core_agg.csv",
        "format": "csv"
      },
      "position": {
        "x": 1140,
        "y": 180
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "excel",
      "target": "field_mapper"
    },
    {
      "id": "e2",
      "source": "field_mapper",
      "target": "filter"
    },
    {
      "id": "e3",
      "source": "filter",
      "target": "sort"
    },
    {
      "id": "e4",
      "source": "sort",
      "target": "agg"
    },
    {
      "id": "e5",
      "source": "agg",
      "target": "dest"
    }
  ],
  "metadata": {
    "demo": true,
    "requires_demo_mode": true,
    "use_case": "core-path"
  }
}
