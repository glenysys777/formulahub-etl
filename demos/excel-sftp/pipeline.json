{
  "id": "demo-excel-sftp",
  "name": "Excel → File → SFTP (demo mock)",
  "description": "Read local Excel, write CSV, mock-upload via sftp_destination to data/out/sftp_mock/. Not a real SFTP server.",
  "version": "1.0",
  "nodes": [
    {
      "id": "excel",
      "type": "excel_source",
      "label": "Excel Source",
      "config": {
        "path": "fixtures/sample/orders.xlsx",
        "sheet_name": "Orders",
        "has_header": true
      },
      "position": { "x": 40, "y": 180 }
    },
    {
      "id": "map",
      "type": "column_map",
      "label": "Column Map",
      "config": {
        "mappings": [
          "Order ID:order_id",
          "Customer ID:customer_id",
          "Customer Name:customer_name",
          "Email:email",
          "Product SKU:product_sku",
          "Qty:quantity",
          "Amount:amount",
          "Order Date:order_date",
          "Status:status"
        ],
        "drop_unmapped": true
      },
      "position": { "x": 260, "y": 180 }
    },
    {
      "id": "dest",
      "type": "local_file_destination",
      "label": "Local CSV",
      "config": {
        "path": "data/out/excel_sftp_orders.csv",
        "format": "csv"
      },
      "position": { "x": 480, "y": 180 }
    },
    {
      "id": "sftp_out",
      "type": "sftp_destination",
      "label": "SFTP Dest (demo)",
      "config": {
        "host": "demo",
        "remote_path": "/outgoing/excel_sftp_orders.csv",
        "local_path": "data/out/excel_sftp_orders.csv"
      },
      "position": { "x": 700, "y": 180 }
    }
  ],
  "edges": [
    { "id": "e1", "source": "excel", "target": "map" },
    { "id": "e2", "source": "map", "target": "dest" },
    { "id": "e3", "source": "dest", "target": "sftp_out" }
  ],
  "metadata": {
    "demo": true,
    "requires_demo_mode": true,
    "use_case": "excel-sftp",
    "workspace_folder": "Pipelines/Demos"
  }
}
